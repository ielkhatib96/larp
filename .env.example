# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign login tokens. Any long random string.
JWT_SECRET=change-me

# Key needed to call /api/admin/* routes (development only).
ADMIN_KEY=change-me

# Anthropic API key, used only to tag events (Step 6).
ANTHROPIC_API_KEY=

# true = no live scraping and no live Claude calls (safe for the demo).
DEMO_MODE=true
